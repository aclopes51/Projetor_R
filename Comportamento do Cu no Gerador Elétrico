#   ☢️ Criando o Modelo GMM (quarto modelo com "lag":
# 👉 As funções de momento especificam as condições d ortogonalidade (instrumentos × resíduos). 
# Para um modelo linear:
#                         Cut = β0 + β1TOCt + β2O2t + ϵt

mkf7 <- mkf6 %>%
  mutate(
    TOC_lag2 = lag(TOC_80, 2),
    O_2_lag7 = lag(O2_80, 7),
    Cu_lag2 = lag(Cu_MKF80, 2),
    TOC_MA6 = zoo::rollmean(TOC_80, 6, fill = NA),  # Média móvel
  ) %>% 
  na.omit()  # Remove linhas com NA (geradas pelas defasagens)
print(mkf7)

# Converter tibble para matriz (necessário para a função gmm)
dados_mat <- mkf7 %>% 
  drop_na()

dados_mat2 <- as.matrix(dados_mat)
# Error in theta[2] * TOC : argumento não-numérico para operador binário


# Função de Momento: resíduos x instrumentos
momentos <- function(theta, x) {
  Cu_MKF80 <- x[, "Cu_MKF80"]
  TOC_80 <- x[, "TOC_80"]
  O2_80 <- x[, "O2_80"]
  TOC_lag2 <- x[, "TOC_lag2"]
  O_2_lag7 <- x[, "O_2_lag7"]
  Cu_lag2 <- x[, "Cu_lag2"]
  TOC_MA6 <- x[, "TOC_MA6"]
  
  erro <- Cu_MKF80 - (theta[1] + theta[2] * TOC_80 + theta[3] * O2_80 + theta[4] * Cu_lag2) 
  
  # Condições de momento: E[erro * instrumentos] = 0
  return(cbind(
    erro,
    erro*x[,3],  # TOC_lag1
    erro*x[,4],  # O2_lag1
    erro*x[,5],  # TOC_lag2
    erro*x[,6],  # O2_lag2
    erro*x[,7],  # TOC_lag3
    erro*x[,8]   # Média móvel TOC
  ))
}

# Estimação GMM (two-step é mais eficiente)
modelo_gmm2 <- gmm(
  g = momentos,
  x = dados_mat,
  t0 = c(1.1, 1.1, 1.3, 1.1),         # Valores iniciais para beta0, beta1, beta2
  type = "twoStep",        # Estimação em dois estágios
  kernel = "Bartlett",     # Kernel para HAC
  bw = bwNeweyWest    # Função que calcula automaticamente
)
# Resumo dos resultados
summary(modelo_gmm2) # p-value = 0.97223

# Cut= 4.88+0.0198(TOC)  -0.296(O_2 )+0.261(〖Cu〗_(t-1))

#     🔅 Comportamento dos resíduos:
# Calcule os resíduos manualmente
residuos <- dados_mat[,"Cu_MKF80"] - 
  (coef(modelo_gmm2)[1] + 
     coef(modelo_gmm2)[2] * dados_mat[,"TOC_80"] + 
     coef(modelo_gmm2)[3] * dados_mat[,"O2_80"] +
     coef(modelo_gmm2)[4] * dados_mat[,"Cu_lag2"])

Box.test(residuos, lag = 10, type = "Ljung-Box") # p-value = 0.3605

teste.df <- adf.test(residuos$Cu_MKF80)# H0: Os resíduos não são estacionários (p. raiz unit.)
print(teste.df)                        # H1: Os resíduos são estacionários

#     🎯 Significado para Seu Modelo GMM:
#   ÓTIMAS NOTÍCIAS:
# ✅ Resíduos Estacionários: Seus resíduos não possuem tendência ou padrão temporal
# ✅ Modelo Bem Especificado: O modelo capturou adequadamente as relações entre as variáveis
# ✅ Não há Autocorrelação: Os resíduos não apresentam correlação serial problemática
# ✅ Variáveis Cointegradas: Se as variáveis originais eram não-estacionárias, e
#    las estão cointegradas

#    📈 Implicações Práticas:
# -> O modelo GMM está bem especificado
# -> As estimativas dos parâmetros são confiáveis
# -> Os instrumentos escolhidos são apropriados
# -> O modelo pode ser usado para previsões e inferência

#    🔍 Detalhe Técnico:
#  O valor de -4.93 está bem abaixo dos valores críticos de Dickey-Fuller 
#  (que são em torno de -2.89 para 5% de significância), confirmando a forte rejeição de H₀.

par(mfrow = c(1, 2))
acf(residuos, main = "FAC dos Residuos", lag.max = 10)  # FAC = Função de Autocorrelação
